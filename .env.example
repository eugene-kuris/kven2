LLM_BACKEND_URL=
MEMORY_DIR=
OWUI_API_KEY=
OWUI_BASE_URL=
PROXY_PORT=
SMALL_MODEL_URL=

# Owner-only Telegram relationship stream.
TELEGRAM_BATCH_DEBOUNCE_SECONDS=1.5
TELEGRAM_EXACT_TAIL_TOKEN_BUDGET=4096
TELEGRAM_COMPACTION_ENABLED=1
TELEGRAM_COMPACTION_TRIGGER_TOKEN_THRESHOLD=8192
TELEGRAM_COMPACTION_EXACT_TAIL_RESERVE=4096
TELEGRAM_COMPACTION_TARGET_TOKEN_BUDGET=1536
TELEGRAM_COMPACTION_MIN_ENTRIES=4

# Dedicated P4 planner for native OWUI tool routing.
KVEN2_PLANNER_TOOL_ROUTING_ENABLED=0
KVEN2_PLANNER_TOOL_ROUTING_TIMEOUT=20

# Start the main T4 stream in parallel with the P4 planner.
# Safe only for streamed, non-RAG, automatic tool-choice requests.
KVEN2_SPECULATIVE_PLANNER_ENABLED=0
KVEN2_SPECULATIVE_QUEUE_MAX_CHUNKS=32

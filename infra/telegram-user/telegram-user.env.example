# Install as /etc/kven2/telegram-user.env, owned root:root with mode 0600.
TELEGRAM_USER_API_ID=REPLACE_WITH_NUMERIC_API_ID
TELEGRAM_USER_API_HASH=REPLACE_WITH_API_HASH
TELEGRAM_USER_SESSION_PATH=/agent/data/kven2/telegram_user/kven.session
TELEGRAM_USER_CONTROL_SOCKET=/run/kven2/telegram-user.sock
TELEGRAM_USER_LOG_LEVEL=INFO
